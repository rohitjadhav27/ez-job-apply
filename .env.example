# Shared (pipeline + web)

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname
# Signs magic links and sessions
APP_SECRET=change-me-long-random-string
# Magic link lifetime in hours
LINK_TTL_HOURS=72

# Pipeline tuning

# Minimum match percent to appear in a digest
MIN_MATCH_PCT=75
# Ignore jobs older than this many days
MAX_AGE_DAYS=7
# How many top rule-scored jobs the LLM judges
JUDGE_TOP_N=30
# Cap per digest
MAX_ITEMS_PER_DIGEST=25
# Send a digest even when nothing matched
SEND_EMPTY_DIGEST=true

# LLM providers (OpenAI-compatible), tried in order; a provider with no API key is skipped
LLM_PROVIDERS=gemini,groq
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=your-gemini-key
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=your-groq-key
LLM_GROQ_MODEL=openai/gpt-oss-120b

# Apify token (LinkedIn posts source)
APIFY_TOKEN=your-apify-token

# Gmail SMTP sender for digests
SENDER_EMAIL=sender@example.com
SENDER_APP_PASSWORD=your-gmail-app-password

# Web tool: base URL used for links in digest emails
APP_BASE_URL=https://your-app.vercel.app
# bcrypt hashes from scripts/hash_password.py
PASSWORD_HASH_ALEX=bcrypt-hash-here
PASSWORD_HASH_SAM=bcrypt-hash-here
# Set false only for local http testing (session cookie is Secure by default)
COOKIE_SECURE=true

# Optional: Postgres for DB tests (skipped when unset)
TEST_DATABASE_URL=
