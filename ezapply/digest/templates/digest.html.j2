{% macro card(c) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;border:1px solid #e3e5e8;border-radius:8px;margin:0 0 12px 0;">
<tr><td style="padding:16px 16px 14px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2328;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
<td valign="top" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:22px;font-weight:bold;color:#1f2328;">{% if c.url %}<a href="{{ c.url }}" style="color:#1f2328;text-decoration:none;">{{ c.title }}</a>{% else %}{{ c.title }}{% endif %}</td>
<td valign="top" align="right" width="64" style="padding-left:10px;"><span style="display:inline-block;background-color:{{ c.colour }};color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;font-weight:bold;padding:3px 10px;border-radius:12px;white-space:nowrap;">{{ c.pct }}%</span></td>
</tr></table>
<div style="font-size:13px;line-height:19px;color:#59636e;margin-top:4px;">{{ c.meta | join(' · ') }}</div>
{% if c.reason %}
<div style="font-size:14px;line-height:21px;color:#1f2328;margin-top:12px;"><strong>Why:</strong> {{ c.reason }}</div>
{% endif %}
{% if c.gap %}
<div style="font-size:14px;line-height:21px;color:#1f2328;margin-top:4px;"><strong>Gap:</strong> {{ c.gap }}</div>
{% endif %}
{% if c.resume %}
<div style="font-size:13px;line-height:19px;color:#59636e;margin-top:8px;">Suggested resume: {{ c.resume }}</div>
{% endif %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;"><tr>
<td style="font-size:0;line-height:0;">
{% if c.apply_url %}
<a href="{{ c.apply_url }}" style="display:inline-block;background-color:#1f2328;color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:bold;text-decoration:none;padding:10px 18px;border-radius:6px;margin:0 8px 8px 0;">&#9993; Apply with email</a>
{% endif %}
{% if c.url %}
<a href="{{ c.url }}" style="display:inline-block;background-color:#ffffff;color:#1f2328;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:20px;font-weight:bold;text-decoration:none;padding:9px 17px;border:1px solid #c9ccd1;border-radius:6px;margin:0 8px 8px 0;">{{ c.view_label }}</a>
{% endif %}
</td>
</tr></table>
</td></tr>
</table>
{% endmacro %}
{% macro heading(label) %}
<div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;font-weight:bold;letter-spacing:0.6px;text-transform:uppercase;color:#59636e;padding:12px 4px 10px 4px;">{{ label }}</div>
{% endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Ez Apply</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f5f7" style="background-color:#f4f5f7;">
<tr><td align="center" style="padding:20px 12px;">
<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;">
<tr><td style="padding:4px 4px 16px 4px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2328;">
<div style="font-size:22px;line-height:28px;font-weight:bold;color:#1f2328;">Ez Apply <span style="font-size:14px;font-weight:normal;color:#59636e;">&nbsp;·&nbsp; {{ date_str }}</span></div>
<div style="font-size:14px;line-height:21px;color:#59636e;margin-top:4px;">Good morning {{ meta.person_name }}. {{ summary }}</div>
</td></tr>
<tr><td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
{% if posts %}
{{ heading("Hiring posts — send an email") }}
{% for c in posts %}
{{ card(c) }}
{% endfor %}
{% endif %}
{% if listings %}
{{ heading("Top matches") }}
{% for c in listings %}
{{ card(c) }}
{% endfor %}
{% endif %}
</td></tr>
<tr><td style="padding:16px 4px 8px 4px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#59636e;border-top:1px solid #e3e5e8;">
<div>Sources: {{ counts or 'none' }}</div>
{% for name, err in source_errors %}
<div style="color:#9a6700;">Failed or skipped: {{ name }} — {{ err }}</div>
{% endfor %}
<div>{{ meta.ai_status }}</div>
<div>Showing matches ≥ {{ meta.threshold }}%</div>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
