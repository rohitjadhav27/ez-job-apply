<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="robots" content="noindex">
<title>{% block title %}Ez Apply{% endblock %}</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<div class="wrap">
{% block header %}
<header class="top">
  <a class="brand" href="/">Ez Apply</a>
  {% if csrf is defined %}
  <form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-small" type="submit">Log out</button></form>
  {% endif %}
</header>
{% endblock %}
{% block content %}{% endblock %}
</div>
{% block scripts %}{% endblock %}
</body>
</html>
